// Buggy Program — designed to demonstrate time-travel debugging
//
// This binary search has an off-by-one bug in its loop condition. It does
// not crash; it silently returns -1 for some values that ARE in the array.
//
// Output:
//   Searching for 7:  index 3      (correct)
//   Searching for 11: index 5      (correct)
//   Searching for 1:  index -1     (WRONG, should be 0)
//   Searching for 15: index -1     (WRONG, should be 7)
//
// To find the bug with the time-travel debugger:
// 1. Click Debug, then jump to the end of the run.
// 2. Step backward to the last `return -1`.
// 3. Look at `lo` and `hi`: they are equal, and arr[lo] is the target.
// 4. The loop exited without checking that last candidate, because the
//    condition is `lo < hi`. The fix is `lo <= hi`.

fn binarySearch(arr, target) {
    let lo = 0
    let hi = arr.length - 1

    while lo < hi {          // BUG: should be lo <= hi
        let mid = int((lo + hi) / 2)
        let value = arr[mid]

        if value == target {
            return mid
        }

        if value < target {
            lo = mid + 1
        } else {
            hi = mid - 1
        }
    }

    return -1  // not found
}

let sorted = [1, 3, 5, 7, 9, 11, 13, 15]

print("Searching for 7:  index " + str(binarySearch(sorted, 7)))
print("Searching for 11: index " + str(binarySearch(sorted, 11)))
print("Searching for 1:  index " + str(binarySearch(sorted, 1)))
print("Searching for 15: index " + str(binarySearch(sorted, 15)))
