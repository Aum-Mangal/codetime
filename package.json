{
  "name": "codetime",
  "version": "1.1.0",
  "description": "A programming language with a visual time-travel debugger",
  "private": true,
  "workspaces": [
    "packages/compiler",
    "packages/cli",
    "packages/ide"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspace=@codetime/compiler",
    "test:golden": "node scripts/check-golden.mjs",
    "test:e2e": "npm run test:e2e --workspace=@codetime/ide",
    "bench": "npm run bench --workspace=@codetime/compiler",
    "bench:replay": "npm run bench:replay --workspace=@codetime/compiler",
    "lint": "eslint . --max-warnings 0",
    "clean": "npm run clean --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=9.0.0"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  }
}
