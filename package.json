{
  "name": "codetime",
  "version": "1.0.0",
  "description": "A programming language with a visual time-travel debugger",
  "private": true,
  "workspaces": [
    "packages/compiler",
    "packages/cli",
    "packages/ide"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "bench": "npm run bench --workspace=@codetime/compiler",
    "lint": "eslint .",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  }
}
