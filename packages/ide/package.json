{
  "name": "@codetime/ide",
  "version": "1.2.0",
  "description": "Browser-based Visual Time-Travel IDE for the CodeTime programming language",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@codetime/compiler": "^1.2.0",
    "@monaco-editor/react": "^4.6.0",
    "lucide-react": "^1.61.0",
    "monaco-editor": "^0.57.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.0",
    "vite": "^7.1.0"
  }
}
